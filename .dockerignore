# Build context hygiene. Everything here is either regenerated inside the image
# or would defeat the point of testing in a clean environment.

# Reinstalled by `npm ci`. Copying the host tree in would hide exactly the
# platform and lockfile problems this image exists to find.
node_modules

# Build outputs, all regenerated by `npm run cf:build`.
.next
.open-next

# Local wrangler/miniflare state, including the local D1. A stale database
# carried in from the host would make a migration failure look like a pass.
.wrangler
local.db
local.db-journal
local.db-wal

# Secrets. `.dev.vars.example` is deliberately NOT excluded — it is the
# documentation of what the real file needs.
.dev.vars

.git
.github
.agents
.claude
*.log
tsconfig.tsbuildinfo
