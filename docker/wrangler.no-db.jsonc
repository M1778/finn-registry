{
  // A deliberately misconfigured Worker: everything wrangler.jsonc has except the
  // D1 binding.
  //
  // It exists to test one thing — that `getDb()` reports a missing binding as a
  // missing binding. That branch is the fallback to a local SQLite file, which is
  // excluded from the Worker bundle entirely (see next.config.ts), so without the
  // guard a Worker deployed against an unset database_id would fail on a module
  // that is not there rather than on the thing that is actually wrong.
  //
  // Keep compatibility_date and compatibility_flags in step with wrangler.jsonc:
  // a drift here would test a runtime nobody deploys.
  "name": "finn-registry-no-db",
  "main": "../.open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../.open-next/assets",
    "binding": "ASSETS"
  }
}
